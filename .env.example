# Copy to .env (same folder as this file) and fill in. .env is git-ignored; never commit it.
# A variable already exported in your shell takes precedence over this file.
OPENAI_API_KEY=

# Optional overrides. The defaults (model and reasoning effort per role) are the CONFIG dict at the
# top of backend/sightline/llm.py; change them there, or here without touching code.
# SIGHTLINE_MODEL=gpt-5.6-terra             # the three audience personas (also profile inference and recommendations)
# SIGHTLINE_EFFORT=low                      # none | low | medium | high | xhigh | max. Set on every call: OpenAI's own default is medium.
# SIGHTLINE_STRUCTURING_MODEL=gpt-5.6-luna  # the field-wise structuring + proposition-coverage call
# SIGHTLINE_STRUCTURING_EFFORT=low
# SIGHTLINE_HELPER_MODEL=gpt-5.6-luna       # describes figures at upload
# SIGHTLINE_HELPER_EFFORT=low
# SIGHTLINE_OFFLINE=1           # cache-only: a cache miss fails instead of calling the API
# SIGHTLINE_COMPARATOR=fieldwise            # fieldwise (default) | cosine: the one-line rollback to whole-takeaway cosine
# SIGHTLINE_FIGURE_INPUT=image+description  # image+description (default) | description_only: withhold the image on described figure slides
