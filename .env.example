# Copy to .env (same folder as this file) and fill in. .env is git-ignored; never commit it.
# A variable already exported in your shell takes precedence over this file.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown in backend/sightline/llm.py)
# SIGHTLINE_MODEL=claude-sonnet-5   # claude-haiku-4-5 failed the gate (novice reads like the expert)
# SIGHTLINE_EFFORT=low          # "none" OMITS the parameter, so the API default (high, slower) applies.
#                                # Haiku 4.5 never receives it.
# SIGHTLINE_OFFLINE=1           # cache-only: a cache miss fails instead of calling the API
# SIGHTLINE_INTENT_MODEL=claude-haiku-4-5   # writes each slide's intended reading (a rephrasing task)
# SIGHTLINE_INTENT_MODE=template            # skip that call; use the expert's own claim (see README, Latency)
